# ============================================================
# VoiceGuard Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sarvam AI (Speech-to-Text) ---
SARVAM_API_KEY=

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Redis (ElastiCache in prod, localhost in dev) ---
REDIS_URL=redis://localhost:6379/0

# --- DynamoDB ---
DYNAMODB_TABLE_NAME=call_sessions

# --- S3 (optional — for debug audio/feature dumps) ---
S3_BUCKET_NAME=voiceguard-debug
S3_ENABLED=false

# --- SNS (Alerting fan-out) ---
SNS_TOPIC_ARN=

# --- Firebase Cloud Messaging ---
FCM_SERVER_KEY=

# --- Risk Engine Thresholds ---
RISK_THRESHOLD_MEDIUM=70
RISK_THRESHOLD_HIGH=85

# --- Ensemble Weights (Model A = deep model, Model B = XGBoost) ---
ENSEMBLE_WEIGHT_MODEL_A=0.6
ENSEMBLE_WEIGHT_MODEL_B=0.4

# --- Caller Multipliers ---
CALLER_MULTIPLIER_UNKNOWN=1.3
CALLER_MULTIPLIER_FLAGGED=1.5

# --- Pipeline ---
ROLLING_WINDOW_SIZE=10
AUDIO_CHUNK_DURATION_SEC=2.0
AUDIO_CHUNK_OVERLAP_SEC=0.5

# --- App / Server ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_KEY=your-api-key-here
